VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App environment: development | staging | production
VITE_APP_ENV=development

# Commercial license (16+ chars) — client watermark uses VITE_; enforce server-side with MEDORA_*
# VITE_MEDORA_LICENSE_KEY=your-issued-license-key
# MEDORA_LICENSE_KEY=your-issued-license-key
# VITE_MEDORA_PLAN=professional
# MEDORA_PLAN=professional
# VITE_HOSPITAL_DISPLAY_NAME=Oak Haven Medical Center

# Demo staff logins — MUST be false / unset on licensed hospital deploys
# Defaults: enabled in vite dev, disabled in production builds
# VITE_ALLOW_DEMO_AUTH=false
# ALLOW_DEMO_PERSIST=false

# Allow localStorage clinical mocks when Supabase is unavailable — false in production
# VITE_ALLOW_CLIENT_MOCKS=false

# YouTube Data API v3 — opt-in only; app uses TheMealDB/Piped by default (no quota burn)
# YOUTUBE_SEARCH_ENABLED=1
YOUTUBE_API_KEY=

GROQ_API_KEY=
HUGGINGFACE_TOKEN=

# Supabase service role — required for hospital persist + diet media cache + AI audit
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Native app + hospital persist / AI auth (set same key in EXPO_PUBLIC_MEDORA_AI_KEY)
MEDORA_AI_API_KEY=generate-a-random-secret

# HIPAA / compliance (defaults are production-safe)
MEDORA_AI_PHI_REDACTION=true
MEDORA_AI_ALLOW_CLOUD_PHI=false
MEDORA_AI_REQUIRE_BAA=true
MEDORA_AI_BAA_GEMINI=true
MEDORA_AI_BAA_GROQ=false
MEDORA_AI_BAA_HUGGINGFACE=false
MEDORA_AI_AUDIT_LOG=true
